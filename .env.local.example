# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of this app (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Access control — invite-only, no self-serve signup.
# One-time bootstrap identity: the only account allowed to sign in before
# any invites exist. Gets 'admin' automatically on its first login.
SEED_ADMIN_EMAIL=cw2252@cornell.edu
# Domains an admin may invite from (comma-separated).
INVITE_ALLOWED_DOMAINS=cornell.edu,gmail.com

# Ask bar. Without it /ask reports itself unconfigured rather than failing.
ANTHROPIC_API_KEY=

# cornellec.com reads the members_public view; after a profile save the
# dashboard POSTs here so the site drops its cache at once. Leave both unset
# locally. The secret must equal REVALIDATE_SECRET on the site's Vercel.
SITE_REVALIDATE_URL=https://cornellec.com/api/revalidate
SITE_REVALIDATE_SECRET=
