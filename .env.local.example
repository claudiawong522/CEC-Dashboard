# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of this app (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Access control — invite-only, no self-serve signup.
# One-time bootstrap identity: the only account allowed to sign in before
# any invites exist. Gets 'admin' automatically on its first login.
SEED_ADMIN_EMAIL=cw2252@cornell.edu
# Domains an admin may invite from (comma-separated).
INVITE_ALLOWED_DOMAINS=cornell.edu,gmail.com
